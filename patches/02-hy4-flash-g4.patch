+template<typename dst_t>
+static __global__ void k_get_rows_q8_0_coal(
+        const void * __restrict__ src0, const int32_t * __restrict__ src1, dst_t * __restrict__ dst,
+        const void * __restrict__ src0_ov, const int64_t ne01_vram,
+        const int64_t ne00, const int64_t ne10,
+        const size_t nb01, const size_t s10, const size_t s1) {
+    constexpr int NWARPS = 4;
+    __shared__ uint32_t smem[NWARPS][304];
+
+    const int warp_id = threadIdx.y;
+    const int lane    = threadIdx.x;
+    const int64_t row_idx = (int64_t) blockIdx.x * NWARPS + warp_id;
+    if (row_idx >= ne10) {
+        return;
+    }
+
+    const int32_t i01 = src1[row_idx * s10];
+    const bool use_ov = src0_ov != nullptr && i01 >= ne01_vram;
+    const int64_t row_off = use_ov ? (i01 - ne01_vram) : i01;
+    const uintptr_t src_addr = (uintptr_t) ((const char *) (use_ov ? src0_ov : src0) + row_off * nb01);
+
+    const int n_blocks   = (int) (ne00 / QK8_0);
+    const int row_bytes  = n_blocks * (int) sizeof(block_q8_0);
+    const int row_u32    = row_bytes >> 2;
+    const int lead_u32   = (int) (((16u - (src_addr & 15u)) & 15u) >> 2);
+    const int n_u4       = (row_u32 - lead_u32) >> 2;
+    const int tail_start = lead_u32 + (n_u4 << 2);
+
+    uint32_t * srow = smem[warp_id];
+    if (lane < lead_u32) {
+        srow[lane] = ((const uint32_t *) src_addr)[lane];
+    }
+    const uint4 * src_u4 = (const uint4 *) (src_addr + (size_t) (lead_u32 << 2));
+    for (int i = lane; i < n_u4; i += WARP_SIZE) {
+        const uint4 v = src_u4[i];
+        const int o = lead_u32 + (i << 2);
+        srow[o + 0] = v.x;
+        srow[o + 1] = v.y;
+        srow[o + 2] = v.z;
+        srow[o + 3] = v.w;
+    }
+    if (tail_start + lane < row_u32) {
+        srow[tail_start + lane] = ((const uint32_t *) src_addr)[tail_start + lane];
+    }
+    __syncwarp();
+
+    dst_t * dst_row = dst + row_idx * s1;
+    const block_q8_0 * blks = (const block_q8_0 *) srow;
+    for (int b = 0; b < n_blocks; ++b) {
+        const float d = __half2float(blks[b].d);
+        const float v = d * (float) blks[b].qs[lane];
+        dst_row[b * QK8_0 + lane] = ggml_cuda_cast<dst_t>(v);
+    }
+}
