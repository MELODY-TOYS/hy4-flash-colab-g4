+void llama_context::dfly_propose_batch(
+        const llama_dfly_request * reqs,
+        llama_dfly_result * outs,
+        llama_dfly_status * statuses,
+        int32_t n_req) {
+    if (n_req <= 0) {
+        return;
+    }
+    if (n_req == 1) {
+        statuses[0] = dfly_propose(reqs[0], outs[0]);
+        return;
+    }
+
+    const auto & hp = model.hparams;
+    const int32_t n_vocab = model.vocab.n_tokens();
+    const int64_t S       = hp.dfly_target_index_top_k;
+    const uint32_t n_embd = hp.n_embd;
+
+    const bool bad_embd = cparams.embeddings || cparams.embeddings_nextn ||
+        std::any_of(cparams.embeddings_layer_inp.begin(), cparams.embeddings_layer_inp.end(), [](bool b) { return b; });
+
+    struct item {
+        int32_t  req_idx;
+        size_t   snap_idx;
+        int32_t  k_step;
+        uint32_t strm;
+    };
+    std::vector<item> valid;
+    valid.reserve(n_req);
+    std::vector<uint8_t> snap_claimed(dfly_snaps.size(), 0);
+
+    // Phase 1: validate each request and locate/validate its snapshot independently
+    for (int32_t i = 0; i < n_req; ++i) {
+        outs[i].n_tokens = 0;
+        statuses[i] = LLAMA_DFLY_BAD_REQUEST;
+
+        const auto & req = reqs[i];
+        const int32_t K = req.k_step;
+        if (K < 0 || outs[i].capacity < K || (K > 0 && outs[i].tokens == nullptr)) {
+            continue;
+        }
+        if (req.seq_id < 0 || (uint32_t) req.seq_id >= cparams.ctx_other->n_seq_max()) {
+            continue;
+        }
+        if (req.anchor_token < 0 || req.anchor_token >= n_vocab || req.anchor_pos < 0) {
+            continue;
+        }
+        if (K >= (int32_t) cparams.n_ubatch || bad_embd) {
+            continue;
+        }
+        if (K == 0) {
+            statuses[i] = LLAMA_DFLY_OK;
+            continue;
+        }
+        if (cparams.dfly_force_prev) {
+            // Forced prev chain is single-slot test mode; delegate directly
+            statuses[i] = dfly_propose(req, outs[i]);
+            continue;
+        }
+
+        const llama_pos p = req.anchor_pos - 1;
+        size_t snap_idx = SIZE_MAX;
+        for (size_t j = 0; j < dfly_snaps.size(); ++j) {
+            if (dfly_snaps[j].seq_id == req.seq_id && dfly_snaps[j].query_pos == p && !dfly_consumed[j] && !snap_claimed[j]) {
+                snap_idx = j;
+                break;
+            }
+        }
+        if (snap_idx == SIZE_MAX) {
+            statuses[i] = LLAMA_DFLY_NO_SNAPSHOT;
+            continue;
+        }
+
+        std::string err;
+        if (!dfly_check_snapshot(dfly_snaps[snap_idx], req.seq_id, err)) {
+            LLAMA_LOG_ERROR("%s: seq %d pos %d decode %" PRIu64 ": bad snapshot: %s\n",
+                    __func__, req.seq_id, p, dfly_snaps[snap_idx].decode_id, err.c_str());
+            statuses[i] = LLAMA_DFLY_BAD_SNAPSHOT;
+            continue;
+        }
+
+        snap_claimed[snap_idx] = 1;
+        valid.push_back({ i, snap_idx, K, dfly_snaps[snap_idx].layer[0].strm });
+    }
+
+    if (valid.empty()) {
+        synchronize();
+        return;
+    }
+
+    // Group valid items by (k_step, strm)
+    std::stable_sort(valid.begin(), valid.end(), [](const item & a, const item & b) {
+        if (a.k_step != b.k_step) {
+            return a.k_step < b.k_step;
+        }
+        return a.strm < b.strm;
+    });
+
+    // Target must finish writing K cache once before any draft reads
+    cparams.ctx_other->synchronize();
+
+    constexpr int32_t MAX_DFLY_BATCH = 8;
+    size_t pos = 0;
+    while (pos < valid.size()) {
+        const int32_t  K     = valid[pos].k_step;
+        const uint32_t strm  = valid[pos].strm;
+        const int32_t  W     = K + 1;
+        const int32_t  max_b = std::max<int32_t>(1, std::min<int32_t>(MAX_DFLY_BATCH, (int32_t) (cparams.n_ctx / (uint32_t) W)));
+        size_t end = pos + 1;
+        while (end < valid.size() && valid[end].k_step == K && valid[end].strm == strm &&
+               (int32_t) (end - pos) < max_b) {
+            ++end;
+        }
+
+        const int32_t B = (int32_t) (end - pos);
+        if (B == 1) {
+            const int32_t ri = valid[pos].req_idx;
+            statuses[ri] = dfly_propose(reqs[ri], outs[ri]);
+            pos = end;
+            continue;
+        }
+
+        try {
+            sched_reserve();
+
+            dfly_inp.n_batch_slots = B;
+            dfly_inp.h_t.resize((size_t) B * n_embd);
+            for (uint32_t il = 0; il < LLAMA_DFLY_N_LAYER; ++il) {
+                dfly_inp.cell[il].resize((size_t) B * S);
+                dfly_inp.mask[il].assign((size_t) B * (S + W) * W, -INFINITY);
+            }
+
+            for (int32_t b = 0; b < B; ++b) {
+                const auto & snap = dfly_snaps[valid[pos + b].snap_idx];
+                std::copy(snap.h_final.begin(), snap.h_final.end(), dfly_inp.h_t.begin() + (size_t) b * n_embd);
+                for (uint32_t il = 0; il < LLAMA_DFLY_N_LAYER; ++il) {
+                    const auto & l = snap.layer[il];
+                    const int64_t n = (int64_t) l.cell.size();
+                    int32_t * cell_b = dfly_inp.cell[il].data() + (size_t) b * S;
+                    std::fill(cell_b, cell_b + S, (int32_t) l.cell.back());
+                    std::copy(l.cell.begin(), l.cell.end(), cell_b);
+
+                    float * mask_b = dfly_inp.mask[il].data() + (size_t) b * (S + W) * W;
+                    for (int32_t j = 0; j < W; ++j) {
+                        float * row = mask_b + (size_t) j * (S + W);
+                        std::fill(row, row + n, 0.0f);
+                        std::fill(row + S, row + S + j + 1, 0.0f);
+                    }
+                }
+            }
+
+            llama_batch_allocr local_balloc(model.hparams.n_pos_per_embd());
+            llama_ubatch ubatch = local_balloc.ubatch_reserve((uint32_t) (B * W), 1);
+            ubatch.seq_id_unq[0] = reqs[valid[pos].req_idx].seq_id;
+
+            for (int32_t b = 0; b < B; ++b) {
+                const auto & req = reqs[valid[pos + b].req_idx];
+                for (int32_t j = 0; j < W; ++j) {
+                    const int32_t idx = b * W + j;
+                    llama_token tok = model.vocab.token_mask();
+                    if (j == 0) {
+                        tok = req.anchor_token;
+                    } else if ((int32_t) dfly_test_block.size() >= j) {
+                        tok = dfly_test_block[j - 1];
+                    }
+                    ubatch.token[idx]    = tok;
+                    ubatch.pos[idx]      = req.anchor_pos + j;
+                    ubatch.n_seq_id[idx] = 1;
+                    ubatch.seq_id[idx]   = &ubatch.seq_id_unq[0];
+                    ubatch.output[idx]   = 0;
+                }
+            }
+
+            n_outputs = 0;
+            ggml_status status;
+            const auto * res = process_ubatch(ubatch, LLM_GRAPH_TYPE_DEFAULT, nullptr, status);
+            if (res == nullptr || (int32_t) res->t_dfly_tokens.size() != K || (int32_t) res->t_dfly_finite.size() != K) {
+                LLAMA_LOG_ERROR("%s: batched draft graph (B=%d, K=%d) failed, status %d\n", __func__, B, K, (int) status);
+                for (int32_t b = 0; b < B; ++b) {
+                    statuses[valid[pos + b].req_idx] = LLAMA_DFLY_COMPUTE_FAILED;
+                }
+                synchronize();
+                dfly_inp.n_batch_slots = 1;
+                pos = end;
+                continue;
+            }
+
+            std::vector<int32_t> raw((size_t) K * B);
+            std::vector<float>   finite((size_t) K * B);
+            for (int32_t j = 0; j < K; ++j) {
+                ggml_tensor * tr = res->t_dfly_tokens[j];
+                ggml_tensor * tf = res->t_dfly_finite[j];
+                ggml_backend_tensor_get_async(ggml_backend_sched_get_tensor_backend(sched.get(), tr), tr,
+                        raw.data() + (size_t) j * B,    0, (size_t) B * sizeof(int32_t));
+                ggml_backend_tensor_get_async(ggml_backend_sched_get_tensor_backend(sched.get(), tf), tf,
+                        finite.data() + (size_t) j * B, 0, (size_t) B * sizeof(float));
+            }
+            synchronize();
+
+            std::vector<int32_t> raw_b(K);
+            std::vector<float>   fin_b(K);
+            for (int32_t b = 0; b < B; ++b) {
+                const int32_t ri = valid[pos + b].req_idx;
+                for (int32_t j = 0; j < K; ++j) {
+                    raw_b[j] = raw[(size_t) j * B + b];
+                    fin_b[j] = finite[(size_t) j * B + b];
+                }
+                std::string err;
+                if (!llama_dfly_check_draft(raw_b.data(), fin_b.data(), K, n_vocab, err)) {
+                    LLAMA_LOG_ERROR("%s: seq %d pos %d: batched draft dropped: %s\n",
+                            __func__, reqs[ri].seq_id, reqs[ri].anchor_pos - 1, err.c_str());
+                    statuses[ri] = LLAMA_DFLY_BAD_TOKEN;
+                    continue;
+                }
+                std::copy(raw_b.begin(), raw_b.end(), outs[ri].tokens);
+                outs[ri].n_tokens = K;
+                dfly_consumed[valid[pos + b].snap_idx] = true;
+                statuses[ri] = LLAMA_DFLY_OK;
+            }
+        } catch (const std::exception & e) {
+            LLAMA_LOG_ERROR("%s: batched draft (B=%d, K=%d): %s\n", __func__, B, K, e.what());
+            for (int32_t b = 0; b < B; ++b) {
+                statuses[valid[pos + b].req_idx] = LLAMA_DFLY_COMPUTE_FAILED;
+            }
+            synchronize();
+        }
+
+        dfly_inp.n_batch_slots = 1;
+        pos = end;
+    }
+
+    synchronize();
+}
