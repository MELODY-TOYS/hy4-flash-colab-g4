+    ggml_cuda_pdl_sync();
+    const int64_t dst_row = *(src1 + i10*s10 + i11*s11 + i12*s12);
+
+    const bool use_ov = dst_ov != nullptr && dst_row >= ne1_vram;
+    const int64_t row_off = use_ov ? (dst_row - ne1_vram) : dst_row;
+
+    const float * src0_row = src0 + i01*s01 + i02*s02 + i03*s03;
+    uint8_t * dst_row_ptr  = (use_ov ? dst_ov : dst) + (row_off*s1 + i02*s2 + i03*s3);
+    uint8_t * s_buf        = (uint8_t *) smem_u32[warp_id];
+
+    for (int b0 = 0; b0 < n_blocks; b0 += CHUNK_BLOCKS) {
+        const int nb = min(CHUNK_BLOCKS, n_blocks - b0);
+        for (int b = 0; b < nb; ++b) {
+            const float v = src0_row[(b0 + b) * QK8_0 + lane];
+            float amax = fabsf(v);
+#pragma unroll
+            for (int off = 16; off > 0; off >>= 1) {
+                amax = fmaxf(amax, __shfl_xor_sync(0xFFFFFFFFu, amax, off, WARP_SIZE));
+            }
+            const float d  = amax / 127.0f;
+            const float id = d ? 1.0f / d : 0.0f;
+            const int8_t q = (int8_t) roundf(v * id);
+            uint8_t * sb = s_buf + b * sizeof(block_q8_0);
+            if (lane == 0) {
+                const half hd = __float2half(d);
+                memcpy(sb, &hd, sizeof(half));
+            }
+            sb[sizeof(half) + lane] = (uint8_t) q;
+        }
+        __syncwarp();
+
+        uint8_t * dst_chunk = dst_row_ptr + b0 * sizeof(block_q8_0);
+        const int chunk_bytes = nb * (int) sizeof(block_q8_0);
+        if ((((uintptr_t) dst_chunk) & 3u) == 0u && (chunk_bytes & 3) == 0) {
+            uint32_t * d32 = (uint32_t *) dst_chunk;
+            const uint32_t * s32 = smem_u32[warp_id];
+            const int n32 = chunk_bytes >> 2;
+            for (int w = lane; w < n32; w += 32) {
+                d32[w] = s32[w];
+            }
+        } else {
+            uint16_t * d16 = (uint16_t *) dst_chunk;
+            const uint16_t * s16 = (const uint16_t *) s_buf;
+            const int n16 = chunk_bytes >> 1;
+            for (int w = lane; w < n16; w += 32) {
+                d16[w] = s16[w];
+            }
+        }
+        __syncwarp();
+    }
+}
