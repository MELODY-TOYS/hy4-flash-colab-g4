+
+static std::mutex & ggml_cuda_pinned_kv_map_mutex() {
+    static std::mutex m;
+    return m;
+}
+
+static std::unordered_map<void *, size_t> & ggml_cuda_pinned_kv_mmap_sizes() {
+    static std::unordered_map<void *, size_t> sizes;
+    return sizes;
+}
+
+static const char * ggml_backend_cuda_pinned_kv_buffer_type_name(ggml_backend_buffer_type_t buft) {
+    auto * ctx = (ggml_cuda_pinned_kv_buft_ctx *) buft->context;
+    return ctx->name.c_str();
+}
+
+static bool ggml_backend_buft_is_cuda_pinned_kv(ggml_backend_buffer_type_t buft) {
+    return buft != nullptr && buft->iface.get_name == ggml_backend_cuda_pinned_kv_buffer_type_name;
+}
+
+static void ggml_backend_cuda_pinned_kv_buffer_free(ggml_backend_buffer_t buffer) {
+    void * ptr = buffer->context;
+    if (!ptr) {
+        return;
+    }
+    size_t mmap_size = 0;
+    {
+        std::lock_guard<std::mutex> lock(ggml_cuda_pinned_kv_map_mutex());
+        auto & mp = ggml_cuda_pinned_kv_mmap_sizes();
+        auto it = mp.find(ptr);
+        if (it != mp.end()) {
+            mmap_size = it->second;
+            mp.erase(it);
+        }
+    }
+    if (mmap_size > 0) {
+#if defined(__linux__)
+        cudaError_t err = cudaHostUnregister(ptr);
+        if (err != cudaSuccess) {
+            (void) cudaGetLastError();
+        }
+        munmap(ptr, mmap_size);
+#endif
+    } else {
+        CUDA_CHECK(cudaFreeHost(ptr));
+    }
+}
+
+static ggml_backend_buffer_t ggml_backend_cuda_pinned_kv_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    auto * buft_ctx = (ggml_cuda_pinned_kv_buft_ctx *) buft->context;
+    ggml_cuda_set_device(buft_ctx->device);
+
+    void * ptr = nullptr;
+    bool is_mmap = false;
+
+#if defined(__linux__)
+    const size_t pad_size = (size + 4095ull) & ~4095ull;
+    void * mapped = mmap(nullptr, pad_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (mapped != MAP_FAILED) {
+        madvise(mapped, pad_size, MADV_HUGEPAGE);
+        volatile char * p = (volatile char *) mapped;
+        for (size_t off = 0; off < pad_size; off += 2 * 1024 * 1024) {
+            p[off] = 0;
+        }
+        cudaError_t reg_err = cudaHostRegister(mapped, pad_size, cudaHostRegisterPortable | cudaHostRegisterMapped);
+        if (reg_err == cudaSuccess) {
+            void * dev_ptr = nullptr;
+            cudaError_t dp_err = cudaHostGetDevicePointer(&dev_ptr, mapped, 0);
+            if (dp_err == cudaSuccess && dev_ptr == mapped) {
+                ptr = mapped;
+                is_mmap = true;
+                std::lock_guard<std::mutex> lock(ggml_cuda_pinned_kv_map_mutex());
+                ggml_cuda_pinned_kv_mmap_sizes()[ptr] = pad_size;
+            } else {
+                (void) cudaGetLastError();
+                (void) cudaHostUnregister(mapped);
+                munmap(mapped, pad_size);
+            }
+        } else {
+            (void) cudaGetLastError();
+            munmap(mapped, pad_size);
+        }
+    }
+#endif
+
+    if (ptr == nullptr) {
+        cudaError_t err = cudaHostAlloc(&ptr, size, cudaHostAllocMapped | cudaHostAllocPortable);
+        if (err != cudaSuccess) {
+            (void) cudaGetLastError();
+            GGML_LOG_ERROR("%s: cudaHostAlloc(%.2f MiB) failed: %s\n", __func__, size / 1024.0 / 1024.0, cudaGetErrorString(err));
+            return nullptr;
+        }
+        void * dev_ptr = nullptr;
+        cudaError_t dp_err = cudaHostGetDevicePointer(&dev_ptr, ptr, 0);
+        if (dp_err != cudaSuccess || dev_ptr != ptr) {
+            (void) cudaGetLastError();
+            GGML_LOG_ERROR("%s: UVA device pointer mismatch for pinned KV buffer (%p vs %p)\n", __func__, ptr, dev_ptr);
+            CUDA_CHECK(cudaFreeHost(ptr));
+            return nullptr;
+        }
+    }
+
+    ggml_backend_buffer_t buffer = ggml_backend_cpu_buffer_from_ptr(ptr, size);
+    buffer->buft = buft;
+    buffer->iface.free_buffer = ggml_backend_cuda_pinned_kv_buffer_free;
+    GGML_LOG_INFO("%s: allocated %s %.2f MiB (%s)\n", __func__,
+            buft_ctx->name.c_str(), size / 1024.0 / 1024.0, is_mmap ? "THP+cudaHostRegister" : "cudaHostAllocMapped");
+    return buffer;
+}
