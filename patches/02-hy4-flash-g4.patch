+    const int64_t n_kv_max   = dst->ne[0];
+    const int64_t n_groups   = dst->ne[1];
+    const int64_t n_top      = top_k->ne[0];
+    const int64_t n_tokens   = top_k->ne[1];
+    const int64_t n_seq_max  = score->ne[0];
+    const int64_t kpool      = pool_idxs->ne[0];
+    const int64_t n_pool     = pool_idxs->ne[1];
