+            const int32_t nv = rng[1];
+
+            const int32_t * tk_row = (const int32_t *) ((const char *) top_k->data + t * top_k->nb[1]);
+            const float   * sc_row = (const float   *) ((const char *) score->data + t * score->nb[1]);
