+void llama_dfly_propose_batch(
+        llama_context * ctx_dfly,
+        const llama_dfly_request * requests,
+        llama_dfly_result * results,
+        llama_dfly_status * statuses,
+        int32_t n_requests) {
+    if (n_requests <= 0) {
+        return;
+    }
+    if (requests == nullptr || results == nullptr || statuses == nullptr) {
+        LLAMA_LOG_ERROR("%s: requests, results and statuses must not be null\n", __func__);
+        if (statuses != nullptr) {
+            for (int32_t i = 0; i < n_requests; ++i) {
+                statuses[i] = LLAMA_DFLY_BAD_REQUEST;
+            }
+        }
+        return;
+    }
+    if (!llama_dfly_check_ctx(ctx_dfly, __func__)) {
+        for (int32_t i = 0; i < n_requests; ++i) {
+            results[i].n_tokens = 0;
+            statuses[i] = LLAMA_DFLY_BAD_REQUEST;
+        }
+        return;
+    }
+    ctx_dfly->dfly_propose_batch(requests, results, statuses, n_requests);
+}
