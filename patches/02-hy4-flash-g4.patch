+//
+// HY4-G4 extensions: Q8_0 target KV + DFly, cell-tiered KV + compact sparse path + state round-trip,
+// and batched multi-slot DFly propose (CPU + GPU when available).
+//
+
+struct hy4_env_guard {
+    std::string key;
+    bool had = false;
+    std::string prev;
+    hy4_env_guard(const char * k, const char * val) : key(k) {
+        if (const char * old = getenv(k)) {
+            had = true;
+            prev = old;
+        }
+#ifndef _WIN32
+        if (val) {
+            setenv(k, val, 1);
+        } else {
+            unsetenv(k);
+        }
+#endif
+    }
+    ~hy4_env_guard() {
+#ifndef _WIN32
+        if (had) {
+            setenv(key.c_str(), prev.c_str(), 1);
+        } else {
+            unsetenv(key.c_str());
+        }
+#endif
+    }
+};
+
+static bool hy4_eval_spy(ggml_tensor * t, bool ask, void * ud) {
+    if (ask) {
+        if (t->op == GGML_OP_KPOOL_SPARSE) {
+            *static_cast<bool *>(ud) = true;
+        }
+        return false;
+    }
+    return true;
+}
