+static __global__ void kpool_sparse_kernel(
+        const int32_t * __restrict__ top_k,
+        const float   * __restrict__ score,
+        const int32_t * __restrict__ pool_idxs,
+        const int32_t * __restrict__ tail_idxs,
+        const int32_t * __restrict__ tok_pool_range,
+        int32_t       * __restrict__ dst_rows,
+        int32_t       * __restrict__ dst_bits,
+        const int32_t group_size,
+        const int32_t n_kv_max,
+        const int32_t n_kv_total,
+        const int32_t n_top,
+        const int32_t n_tokens,
+        const int32_t n_seq_max,
+        const int32_t kpool,
+        const int32_t n_pool,
+        const int32_t n_tail,
+        const int64_t stk1,
+        const int64_t ssc1,
+        const int64_t spi1,
+        const int64_t sti1,
+        const int64_t srng1,
+        const int64_t sd1) {
+    constexpr int HT_CAP = 4096;
+    constexpr int HT_MASK = HT_CAP - 1;
+    constexpr int MAX_UNIQUE_POOLS = 2048;
+
+    __shared__ int32_t ht_key[HT_CAP];
+    __shared__ int32_t ht_mask[HT_CAP];
+    __shared__ int32_t unique_slots[MAX_UNIQUE_POOLS];
+    __shared__ int32_t n_unique;
+    __shared__ int32_t tail_cell[32];
+    __shared__ int32_t tail_bits[32];
+    __shared__ int32_t n_tail_u;
+    __shared__ int32_t pad_mask;
+
+    const int tid = threadIdx.x;
+    const int grp = blockIdx.x;
+
+    for (int i = tid; i < HT_CAP; i += blockDim.x) {
+        ht_key[i]  = -1;
+        ht_mask[i] = 0;
+    }
+    if (tid == 0) {
+        n_unique = 0;
+        n_tail_u = 0;
+        int32_t pm = 0;
+        for (int g = 0; g < group_size; ++g) {
+            if (grp * group_size + g >= n_tokens) {
+                pm |= (1 << g);
+            }
+        }
+        pad_mask = pm;
+    }
+    __syncthreads();
+
+    const int total_picks = group_size * n_top;
+    for (int idx = tid; idx < total_picks; idx += blockDim.x) {
+        const int g = idx / n_top;
+        const int j = idx % n_top;
+        const int t = grp * group_size + g;
+        if (t >= n_tokens) {
+            continue;
+        }
+        const int32_t p0 = tok_pool_range[t * srng1 + 0];
+        const int32_t nv = tok_pool_range[t * srng1 + 1];
+        const int32_t lp = top_k[t * stk1 + j];
+        if (lp < 0 || lp >= nv || lp >= n_seq_max) {
+            continue;
+        }
+        if (!(score[t * ssc1 + lp] > -INFINITY)) {
+            continue;
+        }
+        const int32_t gp = p0 + lp;
+        if (gp < 0 || gp >= n_pool) {
+            continue;
+        }
+        uint32_t slot = ((uint32_t) gp * 2654435761u) & HT_MASK;
+        for (int probe = 0; probe < HT_CAP; ++probe) {
+            const int32_t cur = ht_key[slot];
+            if (cur == gp) {
+                atomicOr(&ht_mask[slot], 1 << g);
+                break;
+            }
+            if (cur == -1) {
+                const int32_t prev = atomicCAS(&ht_key[slot], -1, gp);
+                if (prev == -1) {
+                    const int32_t pos = atomicAdd(&n_unique, 1);
+                    if (pos < MAX_UNIQUE_POOLS) {
+                        unique_slots[pos] = (int32_t) slot;
+                    }
+                    atomicOr(&ht_mask[slot], 1 << g);
+                    break;
+                }
+                if (prev == gp) {
+                    atomicOr(&ht_mask[slot], 1 << g);
+                    break;
+                }
+            }
+            slot = (slot + 1) & HT_MASK;
+        }
+    }
+
+    if (tid == 0 && tail_idxs != nullptr && n_tail > 0) {
+        int32_t nu_t = 0;
+        for (int g = 0; g < group_size; ++g) {
+            const int t = grp * group_size + g;
+            if (t >= n_tokens) {
+                continue;
+            }
+            const int32_t * ti_row = tail_idxs + t * sti1;
+            for (int j = 0; j < n_tail; ++j) {
+                const int32_t c = ti_row[j];
+                if (c < 0 || c >= n_kv_total) {
+                    continue;
+                }
+                bool found = false;
+                for (int u = 0; u < nu_t; ++u) {
+                    if (tail_cell[u] == c) {
+                        tail_bits[u] |= (1 << g);
+                        found = true;
+                        break;
+                    }
+                }
+                if (!found && nu_t < 32) {
+                    tail_cell[nu_t] = c;
+                    tail_bits[nu_t] = (1 << g);
+                    ++nu_t;
+                }
+            }
+        }
+        n_tail_u = nu_t;
+    }
+    __syncthreads();
+
+    const int32_t nu_p = min(n_unique, MAX_UNIQUE_POOLS);
+    const int32_t n_pool_cells = nu_p * kpool;
+    const int32_t n_tu = n_tail_u;
+    const int32_t total_out = n_pool_cells + n_tu;
+    const int32_t pm = pad_mask;
+
+    int32_t * out_rows = dst_rows + grp * sd1;
+    int32_t * out_bits = dst_bits + grp * sd1;
+
+    for (int m = tid; m < n_kv_max; m += blockDim.x) {
+        int32_t r = -1;
+        int32_t b = 0;
+        if (m < n_pool_cells) {
+            const int32_t u    = m / kpool;
+            const int32_t k    = m % kpool;
+            const int32_t slot = unique_slots[u];
+            const int32_t gp   = ht_key[slot];
+            const int32_t c    = pool_idxs[gp * spi1 + k];
+            if (c >= 0 && c < n_kv_total) {
+                r = c;
+                b = ht_mask[slot];
+            }
+        } else if (m < total_out) {
+            const int32_t u = m - n_pool_cells;
+            r = tail_cell[u];
+            b = tail_bits[u];
+        }
+        if (m == 0 && pm != 0) {
+            if (r < 0) {
+                r = 0;
+            }
+            b |= pm;
+        }
+        out_rows[m] = r;
+        out_bits[m] = b;
+    }
+}
+
+void ggml_cuda_op_kpool_sparse(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * top_k          = dst->src[0];
+    const ggml_tensor * score          = dst->src[1];
+    const ggml_tensor * pool_idxs      = dst->src[2];
+    const ggml_tensor * tail_idxs      = dst->src[3];
+    const ggml_tensor * tok_pool_range = dst->src[4];
+
+    const int32_t group_size = ggml_get_op_params_i32(dst, 0);
+    const int32_t n_kv_total = ggml_get_op_params_i32(dst, 1);
+
+    const int32_t n_kv_max  = (int32_t) dst->ne[0];
+    const int32_t n_groups  = (int32_t) dst->ne[1];
+    const int32_t n_top     = (int32_t) top_k->ne[0];
+    const int32_t n_tokens  = (int32_t) top_k->ne[1];
+    const int32_t n_seq_max = (int32_t) score->ne[0];
+    const int32_t kpool     = (int32_t) pool_idxs->ne[0];
+    const int32_t n_pool    = (int32_t) pool_idxs->ne[1];
+    const int32_t n_tail    = tail_idxs ? (int32_t) tail_idxs->ne[0] : 0;
+
+    GGML_ASSERT(group_size > 0 && group_size <= 31);
+    GGML_ASSERT((int64_t) group_size * n_top  <= 2048);
+    GGML_ASSERT((int64_t) group_size * n_tail <= 32);
+
+    int32_t * dst_rows = (int32_t *) dst->data;
+    int32_t * dst_bits = (int32_t *) ((char *) dst->data + dst->nb[2]);
+
+    const dim3 grid_dims(n_groups, 1, 1);
+    const dim3 block_dims(256, 1, 1);
+    kpool_sparse_kernel<<<grid_dims, block_dims, 0, ctx.stream()>>>(
+        (const int32_t *) top_k->data,
+        (const float   *) score->data,
+        (const int32_t *) pool_idxs->data,
+        tail_idxs ? (const int32_t *) tail_idxs->data : nullptr,
+        (const int32_t *) tok_pool_range->data,
+        dst_rows, dst_bits,
+        group_size, n_kv_max, n_kv_total, n_top, n_tokens, n_seq_max, kpool, n_pool, n_tail,
+        top_k->nb[1] / sizeof(int32_t),
+        score->nb[1] / sizeof(float),
+        pool_idxs->nb[1] / sizeof(int32_t),
+        tail_idxs ? tail_idxs->nb[1] / sizeof(int32_t) : 0,
+        tok_pool_range->nb[1] / sizeof(int32_t),
+        dst->nb[1] / sizeof(int32_t));
+}
+
+static __global__ void kpool_sparse_mask_kernel(
+        const int32_t * __restrict__ qbits,
+        half          * __restrict__ dst,
+        const int32_t n_kv_max,
+        const int32_t group_size,
+        const int64_t sb1,
+        const int64_t sd1,
+        const int64_t sd3) {
+    const int grp = blockIdx.y;
+    const int m   = blockIdx.x * blockDim.x + threadIdx.x;
+    if (m >= n_kv_max) {
+        return;
+    }
+    const int32_t bits = qbits[grp * sb1 + m];
+    const half zero = __float2half(0.0f);
+    const half ninf = __float2half(-INFINITY);
+    half * base = dst + grp * sd3;
+    for (int g = 0; g < group_size; ++g) {
+        base[g * sd1 + m] = (bits & (1 << g)) ? zero : ninf;
+    }
+}
+
+void ggml_cuda_op_kpool_sparse_mask(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * qbits = dst->src[0];
+    const int32_t group_size  = ggml_get_op_params_i32(dst, 0);
+    GGML_ASSERT(group_size > 0 && group_size <= 31);
+    const int32_t n_kv_max    = (int32_t) qbits->ne[0];
+    const int32_t n_groups    = (int32_t) qbits->ne[1];
+
+    const dim3 block_dims(256, 1, 1);
+    const dim3 grid_dims((n_kv_max + 255) / 256, n_groups, 1);
+    kpool_sparse_mask_kernel<<<grid_dims, block_dims, 0, ctx.stream()>>>(
+        (const int32_t *) qbits->data,
+        (half *) dst->data,
+        n_kv_max, group_size,
+        qbits->nb[1] / sizeof(int32_t),
+        dst->nb[1] / sizeof(half),
+        dst->nb[3] / sizeof(half));
+}
