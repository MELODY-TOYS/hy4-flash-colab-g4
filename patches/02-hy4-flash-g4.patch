+            llama_pos   a_pos[4]   = {};
+            {
+                llama_batch b = llama_batch_init(4, 0, 1);
+                for (int s = 0; s < 4; ++s) {
+                    const int i = b.n_tokens++;
+                    b.token[i]     = seqs[s][lens[s]];
+                    b.pos[i]       = (llama_pos) lens[s];
+                    b.n_seq_id[i]  = 1;
+                    b.seq_id[i][0] = s;
+                    b.logits[i]    = true;
+                }
