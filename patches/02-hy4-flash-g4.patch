+        t.test("HY4_lightning_indexer_indexed_edge_" + tag, [&](testing & t) {
+            ggml_backend_t backend = dev ? ggml_backend_dev_init(dev, nullptr) : ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+            if (!t.assert_true("backend init", backend != nullptr)) {
+                return;
+            }
+
+            constexpr int64_t N_EMBD = 128;
+            constexpr int64_t N_HEAD = 16;
+            constexpr int64_t N_BATCH = 6;
+            constexpr int64_t N_POOL_SEQ_MAX = 64;
+            constexpr int64_t N_POOL_SLOTS = 200;
+            constexpr int64_t N_K_ROWS = 200;
+
+            std::mt19937 rng(4242);
+            std::uniform_real_distribution<float> dist(-0.5f, 0.5f);
+            std::vector<float> q_host(N_EMBD * N_HEAD * N_BATCH);
+            std::vector<float> k_f32(N_EMBD * N_K_ROWS);
+            std::vector<float> w_host(N_HEAD * N_BATCH);
+            for (float & v : q_host) { v = dist(rng); }
+            for (float & v : k_f32)  { v = dist(rng); }
+            for (float & v : w_host) { v = dist(rng) + 0.5f; }
+
+            std::vector<int32_t> pool_slots(N_POOL_SLOTS);
+            for (int64_t i = 0; i < N_POOL_SLOTS; ++i) {
+                pool_slots[i] = (int32_t) ((i * 37 + 13) % N_K_ROWS);
+            }
+
+            // Crafted ranges: at start_kv = 32, t=0 loads p0=0 up to nv=36, t=1 (p0=100, nv=12) is skipped,
+            // t=2 returns to p0=0 with nv=60 (must reload [36..59], not score against zeros!).
+            const int32_t ranges[N_BATCH * 2] = {
+                0,   36,
+                100, 12,
+                0,   60,
+                100, 45,
+                0,   33,
+                100, 64,
+            };
+
+            for (ggml_type k_type : { GGML_TYPE_F16, GGML_TYPE_Q8_0 }) {
+                const size_t k_nbytes = ggml_row_size(k_type, N_EMBD) * N_K_ROWS;
+                std::vector<uint8_t> k_enc(k_nbytes);
+                std::vector<float>   k_ref(N_EMBD * N_K_ROWS);
+                if (k_type == GGML_TYPE_F16) {
+                    ggml_fp32_to_fp16_row(k_f32.data(), (ggml_fp16_t *) k_enc.data(), N_EMBD * N_K_ROWS);
+                    ggml_fp16_to_fp32_row((const ggml_fp16_t *) k_enc.data(), k_ref.data(), N_EMBD * N_K_ROWS);
+                } else {
+                    ggml_quantize_chunk(GGML_TYPE_Q8_0, k_f32.data(), k_enc.data(), 0, N_K_ROWS, N_EMBD, nullptr);
+                    ggml_get_type_traits(GGML_TYPE_Q8_0)->to_float(k_enc.data(), k_ref.data(), N_EMBD * N_K_ROWS);
+                }
+
+                // Exact CPU reference
+                std::vector<float> ref(N_POOL_SEQ_MAX * N_BATCH, -INFINITY);
+                for (int64_t b = 0; b < N_BATCH; ++b) {
+                    const int32_t p0 = ranges[b * 2 + 0];
+                    const int32_t nv = ranges[b * 2 + 1];
+                    for (int64_t j = 0; j < nv; ++j) {
+                        const int32_t slot = pool_slots[p0 + j];
+                        const float * kr = k_ref.data() + (size_t) slot * N_EMBD;
+                        double acc = 0.0;
+                        for (int64_t h = 0; h < N_HEAD; ++h) {
+                            const float * qr = q_host.data() + ((size_t) b * N_HEAD + h) * N_EMBD;
+                            double dot = 0.0;
+                            for (int64_t d = 0; d < N_EMBD; ++d) {
+                                dot += (double) qr[d] * (double) kr[d];
+                            }
+                            if (dot > 0.0) {
+                                acc += dot * (double) w_host[b * N_HEAD + h];
+                            }
+                        }
+                        ref[b * N_POOL_SEQ_MAX + j] = (float) acc;
+                    }
+                }
+
+                for (int32_t tile_toks : { 0, 6 }) {
+                    ggml_init_params ip = { ggml_tensor_overhead() * 16 + ggml_graph_overhead(), nullptr, true };
+                    ggml_context * ctx = ggml_init(ip);
+                    ggml_tensor * q_t = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, N_EMBD, N_HEAD, N_BATCH);
+                    ggml_tensor * k_t = ggml_new_tensor_2d(ctx, k_type, N_EMBD, N_K_ROWS);
+                    ggml_tensor * w_t = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, N_HEAD, N_BATCH);
+                    ggml_tensor * s_t = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, N_POOL_SLOTS);
+                    ggml_tensor * r_t = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 2, N_BATCH);
+                    ggml_tensor * out = ggml_lightning_indexer_indexed(ctx, q_t, k_t, w_t, s_t, r_t, N_POOL_SEQ_MAX);
+                    if (tile_toks > 0) {
+                        out->op_params[0] = tile_toks;
+                    }
+
+                    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+                    ggml_backend_tensor_set(q_t, q_host.data(), 0, ggml_nbytes(q_t));
+                    ggml_backend_tensor_set(k_t, k_enc.data(),  0, ggml_nbytes(k_t));
+                    ggml_backend_tensor_set(w_t, w_host.data(), 0, ggml_nbytes(w_t));
+                    ggml_backend_tensor_set(s_t, pool_slots.data(), 0, ggml_nbytes(s_t));
+                    ggml_backend_tensor_set(r_t, ranges, 0, ggml_nbytes(r_t));
+
+                    ggml_cgraph * gf = ggml_new_graph(ctx);
+                    ggml_build_forward_expand(gf, out);
+                    ggml_backend_graph_compute(backend, gf);
+
+                    std::vector<float> got(N_POOL_SEQ_MAX * N_BATCH);
+                    ggml_backend_tensor_get(out, got.data(), 0, ggml_nbytes(out));
+
+                    float max_err = 0.0f;
+                    bool mask_ok = true;
+                    for (int64_t b = 0; b < N_BATCH; ++b) {
+                        const int32_t nv = ranges[b * 2 + 1];
+                        for (int64_t j = 0; j < N_POOL_SEQ_MAX; ++j) {
+                            const float g = got[b * N_POOL_SEQ_MAX + j];
+                            const float r = ref[b * N_POOL_SEQ_MAX + j];
+                            if (j >= nv) {
+                                mask_ok = mask_ok && std::isinf(g) && g < 0.0f;
+                            } else {
+                                mask_ok = mask_ok && std::isfinite(g);
+                                max_err = std::max(max_err, std::fabs(g - r));
+                            }
+                        }
+                    }
+                    const std::string label = std::string(ggml_type_name(k_type)) + " tile=" + std::to_string(tile_toks);
+                    t.assert_true(label + " mask/finite", mask_ok);
+                    t.assert_true(label + " max_err=" + std::to_string(max_err), max_err < 2e-2f);
+
+                    ggml_backend_buffer_free(buf);
+                    ggml_free(ctx);
+                }
+            }
+            ggml_backend_free(backend);
+        });
+
